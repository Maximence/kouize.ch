# Settings for the online copy of KOUIZE (your classes). Copy to .env.production before `npm run package:hosting`.
# The online copy never uses AI: quizzes are prepared and published from KOUIZE on your computer.

# Online mode: classes, players, leaderboard. The studio pages (subjects, generation, settings) are off.
KOUIZE_HOSTED=1

# Your admin password for /admin (create classes, get the publish token, manage players). Pick a long one.
KOUIZE_ADMIN_PASSWORD=

# Optional: one shared password in front of the whole site (browser prompt). Not needed: classes have their own.
KOUIZE_SITE_PASSWORD=

# Optional: where the database file lives (default ./data/mdquiz.db inside the site folder).
# MDQUIZ_DB_PATH=./data/mdquiz.db

# Optional: email for class invitations, through any SMTP server (e.g. the mailbox that comes with your hosting).
# Without it, invitations still work: whoever invites gets the link to send themselves.
# SMTP_HOST=mail.infomaniak.com
# SMTP_PORT=465
# SMTP_USER=kouize@your-domain.ch
# SMTP_PASSWORD=
# MAIL_FROM="KOUIZE <kouize@your-domain.ch>"

# Optional: the site's public address, for links in emails (default: taken from the request).
# KOUIZE_PUBLIC_URL=https://quiz.your-domain.ch
